{
  "$schema": "https://morita-atsuya.github.io/screen-blueprint-studio/schemas/screen-blueprint-project-v3.schema.json",
  "kind": "screen-blueprint-project",
  "schemaVersion": 3,
  "project": {
    "id": "example-project",
    "name": "Shared Header Example",
    "screenIds": ["home"]
  },
  "componentDefinitions": {
    "shared/header": {
      "id": "shared/header",
      "name": "Shared Header",
      "description": "A reusable product header with selectable spacing.",
      "rootNodeId": "header-root",
      "nodes": {
        "header-root": {
          "nodeType": "inline",
          "id": "header-root",
          "parentId": null,
          "childIds": ["header-title"],
          "kind": "container",
          "placement": { "mode": "flow" },
          "sizing": {
           "inlineSize": "fill",
           "minWidth": "none",
           "maxWidth": "none",
           "gridSpan": 1,
           "grow": 0,
           "shrink": "allow"
          },
          "common": {
            "description": "Header layout",
            "visible": true,
            "enabled": true
          },
          "config": {
            "kind": "container",
            "layout": "horizontal",
            "gap": "md",
            "columns": 1,
            "justify": "between",
            "align": "center",
            "wrap": false
          }
        },
        "header-title": {
          "nodeType": "inline",
          "id": "header-title",
          "parentId": "header-root",
          "childIds": [],
          "kind": "text",
          "placement": { "mode": "flow" },
          "sizing": {
           "inlineSize": "auto",
           "minWidth": "none",
           "maxWidth": "none",
           "gridSpan": 1,
           "grow": 0,
           "shrink": "allow"
          },
          "common": {
            "description": "Product title",
            "visible": true,
            "enabled": true
          },
          "config": {
            "kind": "text",
            "text": "Screen Blueprint",
            "style": "heading2"
          }
        }
      },
      "publicProps": [
        {
          "key": "title",
          "name": "Title",
          "description": "Text displayed as the product title.",
          "type": "string",
          "bindings": [
            {
              "nodePath": ["header-title"],
              "field": "config.text"
            }
          ]
        }
      ],
      "variantProperties": [
        {
          "key": "density",
          "name": "Density",
          "description": "Controls spacing without changing the header topology.",
          "values": ["comfortable", "compact"]
        }
      ],
      "variants": [
        {
          "id": "comfortable",
          "name": "Comfortable",
          "propertyValues": {
            "density": "comfortable"
          },
          "nodeOverrides": {
            "header-root": {
              "config": {
                "gap": "md"
              }
            }
          }
        },
        {
          "id": "compact",
          "name": "Compact",
          "propertyValues": {
            "density": "compact"
          },
          "nodeOverrides": {
            "header-root": {
              "config": {
                "gap": "sm"
              }
            },
            "header-title": {
              "placement": {
                "mode": "overlay",
                "anchor": "topLeft",
                "insetX": "sm",
                "insetY": "sm"
              }
            }
          }
        }
      ],
      "representativeVariantId": "comfortable"
    }
  },
  "screens": {
    "home": {
      "id": "home",
      "name": "Home",
      "route": "/",
      "baseDescription": "The signed-in landing experience before an optional scenario is applied.",
      "rootComponentId": "home-page",
      "modalComponentIds": [],
      "scenarioIds": ["loading"],
      "eventIds": ["activate-loading"]
    }
  },
  "components": {
    "home-page": {
      "nodeType": "inline",
      "id": "home-page",
      "screenId": "home",
      "parentId": null,
      "childIds": ["status-region", "content-region", "product-image", "actions-region", "shared-header", "documentation-link"],
      "kind": "page",
      "placement": { "mode": "flow" },
      "sizing": {
        "inlineSize": "fill",
        "minWidth": "none",
        "maxWidth": "none",
        "gridSpan": 1,
        "grow": 0,
        "shrink": "allow"
      },
      "common": {
        "description": "Home page",
        "visible": true,
        "enabled": true
      },
      "config": {
        "kind": "page",
        "layout": "grid",
        "gap": "lg",
        "columns": 12,
        "justify": "start",
        "align": "stretch",
        "wrap": false
      }
    },
    "shared-header": {
      "nodeType": "definitionInstance",
      "id": "shared-header",
      "screenId": "home",
      "parentId": "home-page",
      "childIds": [],
      "placement": {
        "mode": "sticky",
        "edge": "top",
        "inset": "sm"
      },
      "sizing": {
        "inlineSize": "auto",
        "minWidth": "none",
        "maxWidth": "none",
        "gridSpan": 1,
        "grow": 0,
        "shrink": "allow"
      },
      "source": {
        "$ref": "#/componentDefinitions/shared~1header"
      },
      "variantId": "comfortable",
      "props": {
        "title": "Welcome"
      }
    },
    "status-region": {
      "nodeType": "inline",
      "id": "status-region",
      "screenId": "home",
      "parentId": "home-page",
      "childIds": [],
      "kind": "text",
      "placement": { "mode": "flow" },
      "sizing": {
        "inlineSize": "auto",
        "minWidth": "none",
        "maxWidth": "none",
        "gridSpan": 1,
        "grow": 0,
        "shrink": "allow"
      },
      "common": {
        "description": "Status region spanning one track",
        "visible": true,
        "enabled": true
      },
      "config": {
        "kind": "text",
        "text": "Ready",
        "style": "caption"
      }
    },
    "content-region": {
      "nodeType": "inline",
      "id": "content-region",
      "screenId": "home",
      "parentId": "home-page",
      "childIds": [],
      "kind": "text",
      "placement": { "mode": "flow" },
      "sizing": {
        "inlineSize": "fill",
        "minWidth": "none",
        "maxWidth": "none",
        "gridSpan": 6,
        "grow": 0,
        "shrink": "allow"
      },
      "common": {
        "description": "Primary content region spanning six tracks",
        "visible": true,
        "enabled": true
      },
      "config": {
        "kind": "text",
        "text": "Review the selected task and its latest activity.",
        "style": "body"
      }
    },
    "product-image": {
      "nodeType": "inline",
      "id": "product-image",
      "screenId": "home",
      "parentId": "home-page",
      "childIds": [],
      "kind": "image",
      "placement": { "mode": "flow" },
      "sizing": {
        "inlineSize": "fill",
        "minWidth": "none",
        "maxWidth": "none",
        "gridSpan": 3,
        "grow": 0,
        "shrink": "allow"
      },
      "common": {
        "description": "Product workflow illustration",
        "visible": true,
        "enabled": true
      },
      "config": {
        "kind": "image",
        "source": "./taskflow-board.svg",
        "alt": "Task board organized into three columns",
        "fit": "cover",
        "aspectRatio": "16:9",
        "placeholderStyle": "icon"
      }
    },
    "actions-region": {
      "nodeType": "inline",
      "id": "actions-region",
      "screenId": "home",
      "parentId": "home-page",
      "childIds": [],
      "kind": "button",
      "placement": { "mode": "flow" },
      "sizing": {
        "inlineSize": "auto",
        "minWidth": "none",
        "maxWidth": "none",
        "gridSpan": 2,
        "grow": 0,
        "shrink": "allow"
      },
      "common": {
        "description": "Actions region spanning two tracks",
        "visible": true,
        "enabled": true
      },
      "config": {
        "kind": "button",
        "label": "Open task",
        "variant": "primary",
        "eventId": null,
        "confirmationMessage": null,
        "preventDoubleSubmit": false
      }
    },
    "documentation-link": {
      "nodeType": "inline",
      "id": "documentation-link",
      "screenId": "home",
      "parentId": "home-page",
      "childIds": [],
      "kind": "link",
      "placement": {
        "mode": "viewport",
        "anchor": "bottomRight",
        "insetX": "md",
        "insetY": "md"
      },
      "sizing": {
        "inlineSize": "content",
        "minWidth": "none",
        "maxWidth": "none",
        "gridSpan": 1,
        "grow": 0,
        "shrink": "allow"
      },
      "common": {
        "description": "Product documentation",
        "visible": true,
        "enabled": true
      },
      "config": {
        "kind": "link",
        "label": "Read the documentation",
        "destination": {
          "type": "external",
          "url": "https://github.com/Morita-Atsuya/screen-blueprint-studio"
        },
        "openMode": "newContext"
      }
    }
  },
  "screenScenarios": {
    "loading": {
      "id": "loading",
      "screenId": "home",
      "name": "Loading",
      "description": "Shows a meaningful in-progress presentation.",
      "componentOverrides": [
        {
          "target": {
            "type": "definitionNode",
            "instanceId": "shared-header",
            "nodePath": ["header-title"]
          },
          "override": {
            "text": "Loading…"
          }
        }
      ]
    }
  },
  "events": {
    "activate-loading": {
      "id": "activate-loading",
      "screenId": "home",
      "name": "Activate loading scenario",
      "trigger": {
        "type": "click",
        "target": {
          "type": "definitionNode",
          "instanceId": "shared-header",
          "nodePath": ["header-title"]
        }
      },
      "actions": [
        {
          "type": "setScenario",
          "scenarioId": "loading"
        }
      ]
    }
  },
  "apiOperations": {
    "load-home": {
      "id": "load-home",
      "screenId": "home",
      "name": "Load home",
      "method": "GET",
      "path": "/api/home",
      "requestBindings": [],
      "successScenarioId": null,
      "errorScenarioId": "loading"
    }
  }
}
