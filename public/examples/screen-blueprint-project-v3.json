      "kind": "page",
      "placement": {
        "mode": "flow"
      },
      "common": {
        "description": "Task list page",
        "visible": true,
        "enabled": true
      },
      "config": {
        "kind": "page",
        "layout": "vertical",
        "gap": "md",
        "columns": 6,
        "justify": "start",
        "align": "stretch",
        "wrap": false
      }
    },
    "comp-list-header": {
      "nodeType": "definitionInstance",
      "childIds": [],
