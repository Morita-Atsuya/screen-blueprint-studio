      },
      "id": "comp-task-list",
      "screenId": "screen-list",
      "parentId": "comp-list-page",
      "childIds": [
        "comp-example-collection",
        "comp-launch-task-card"
      ],
      "kind": "container",
      "placement": {
        "mode": "flow"
      },
      "common": {
        "description": "Task card list",
