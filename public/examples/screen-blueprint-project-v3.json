{
  "$schema": "https://morita-atsuya.github.io/screen-blueprint-studio/schemas/screen-blueprint-project-v3.schema.json",
  "kind": "screen-blueprint-project",
  "schemaVersion": 3,
  "project": {
    "id": "proj-taskflow",
    "name": "TaskFlow",
    "screenIds": [
      "screen-list",
      "screen-edit"
    ]
  },
  "componentDefinitions": {
    "shared/header": {
      "id": "shared/header",
      "name": "Shared Header",
      "description": "Reusable TaskFlow heading with controllable density and copy.",
      "rootNodeId": "header-root",
      "nodes": {
        "header-root": {
          "nodeType": "inline",
          "id": "header-root",
          "parentId": null,
          "childIds": [
            "header-copy"
          ],
          "kind": "container",
          "placement": {
            "mode": "flow"
          },
          "sizing": {
            "inlineSize": "fill",
            "minWidth": "none",
            "maxWidth": "none",
            "gridSpan": 1,
            "grow": 0,
            "shrink": "allow"
          },
          "common": {
            "description": "Header layout",
            "visible": true,
            "enabled": true
          },
          "config": {
            "kind": "container",
            "layout": "vertical",
            "gap": "md",
            "columns": 1,
            "justify": "start",
            "align": "stretch",
            "wrap": false
          }
        },
        "header-copy": {
          "nodeType": "inline",
          "id": "header-copy",
          "parentId": "header-root",
          "childIds": [
            "header-title",
            "header-subtitle"
          ],
          "kind": "container",
          "placement": {
            "mode": "flow"
          },
          "sizing": {
            "inlineSize": "auto",
            "minWidth": "none",
            "maxWidth": "none",
            "gridSpan": 1,
            "grow": 0,
            "shrink": "allow"
          },
          "common": {
            "description": "Header copy block",
            "visible": true,
            "enabled": true
          },
          "config": {
            "kind": "container",
            "layout": "vertical",
            "gap": "sm",
            "columns": 1,
            "justify": "start",
            "align": "stretch",
            "wrap": false
          }
        },
        "header-title": {
          "nodeType": "inline",
          "id": "header-title",
          "parentId": "header-copy",
          "childIds": [],
          "kind": "text",
          "placement": {
            "mode": "flow"
          },
          "sizing": {
            "inlineSize": "auto",
            "minWidth": "none",
            "maxWidth": "none",
            "gridSpan": 1,
            "grow": 0,
            "shrink": "allow"
          },
          "common": {
            "description": "Header title",
            "visible": true,
            "enabled": true
          },
          "config": {
            "kind": "text",
            "text": "TaskFlow",
            "style": "heading1"
          }
        },
        "header-subtitle": {
          "nodeType": "inline",
          "id": "header-subtitle",
          "parentId": "header-copy",
          "childIds": [],
          "kind": "text",
          "placement": {
            "mode": "flow"
          },
          "sizing": {
            "inlineSize": "auto",
            "minWidth": "none",
            "maxWidth": "none",
            "gridSpan": 1,
            "grow": 0,
            "shrink": "allow"
          },
          "common": {
            "description": "Header subtitle",
            "visible": true,
            "enabled": true
          },
          "config": {
            "kind": "text",
            "text": "Keep the team aligned on what ships next.",
            "style": "body"
          }
        }
      },
      "publicProps": [
        {
          "key": "title",
          "name": "Title",
          "description": "Primary heading copy.",
          "type": "string",
          "bindings": [
            {
              "nodePath": [
                "header-copy",
                "header-title"
              ],
              "field": "config.text"
            }
          ]
        },
        {
          "key": "subtitle",
          "name": "Subtitle",
          "description": "Supporting heading copy.",
          "type": "string",
          "bindings": [
            {
              "nodePath": [
                "header-copy",
                "header-subtitle"
              ],
              "field": "config.text"
            }
          ]
        }
      ],
      "variantProperties": [
        {
          "key": "density",
          "name": "Density",
          "description": "Controls visual spacing without changing topology.",
          "values": [
            "comfortable",
            "compact"
          ]
        }
      ],
      "variants": [
        {
          "id": "comfortable",
          "name": "Comfortable",
          "propertyValues": {
            "density": "comfortable"
          },
          "nodeOverrides": {
            "header-root": {
              "config": {
                "gap": "md"
              }
            }
          }
        },
        {
          "id": "compact",
          "name": "Compact",
          "propertyValues": {
            "density": "compact"
          },
          "nodeOverrides": {
            "header-root": {
              "config": {
                "gap": "sm"
              }
            },
            "header-subtitle": {
              "config": {
                "style": "caption"
              }
            }
          }
        }
      ],
      "representativeVariantId": "comfortable"
    }
  },
  "screens": {
    "screen-list": {
      "id": "screen-list",
      "name": "Task List",
      "route": "/tasks",
      "baseDescription": "Review the active launch work and open the create form when needed.",
      "rootComponentId": "comp-list-page",
      "modalComponentIds": [
        "comp-create-modal"
      ],
      "scenarioIds": [
        "scenario-list-loading",
        "scenario-list-empty",
        "scenario-list-create",
        "scenario-list-create-error"
      ],
      "eventIds": [
        "event-open-create",
        "event-close-create",
        "event-submit-create",
        "event-edit-launch-task",
        "event-open-task-item"
      ]
    },
    "screen-edit": {
      "id": "screen-edit",
      "name": "Edit Task",
      "route": "/tasks/:taskId",
      "baseDescription": "Update the selected task and confirm before discarding unsaved work.",
      "rootComponentId": "comp-edit-page",
      "modalComponentIds": [
        "comp-discard-modal"
      ],
      "scenarioIds": [
        "scenario-edit-saving",
        "scenario-edit-success",
        "scenario-edit-error",
        "scenario-edit-confirm-exit"
      ],
      "eventIds": [
        "event-save-task",
        "event-cancel-task-edit",
        "event-discard-task-changes",
        "event-continue-task-editing"
      ]
    }
  },
  "components": {
    "comp-list-page": {
      "nodeType": "inline",
      "sizing": {
        "inlineSize": "fill",
        "minWidth": "none",
