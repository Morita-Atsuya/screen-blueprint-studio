        "shrink": "allow"
      },
      "id": "comp-list-summary",
      "screenId": "screen-list",
      "parentId": "comp-list-page",
      "childIds": [],
      "kind": "text",
      "placement": {
        "mode": "flow"
      },
      "common": {
        "description": "Page summary",
        "visible": true,
        "enabled": true
      },
      "config": {
        "kind": "text",
        "text": "Review the launch queue, open the create form, and jump into the active task.",
        "style": "body"
      }
    },
    "comp-task-list": {
      "nodeType": "inline",
